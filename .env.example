# Local-only configuration for the existing F5-TTS installation.
# Copy this file to .env and replace the example paths with your local paths.

F5_TTS_PYTHON=C:\\path\\to\\tts-env\\Scripts\\python.exe
F5_TTS_SCRIPT=C:\\path\\to\\mathscene\\scripts\\tts_clone.py
F5_TTS_REF_AUDIO_DIR=C:\\path\\to\\reference-audio

# Optional: accurate transcript of the reference audio.
# F5_TTS_REF_TEXT=

# Existing local tuning.
F5_TTS_DEVICE=cuda
F5_TTS_NFE_STEP=64
